    <!-- ===== Tips card (first launch, no device connected yet) ===== -->
    <string name="tips_title">Quick tips</string>
    <string name="tips_line_plug_in">Plug the scope into the USB-C port. The app opens itself — tap Allow when Android asks.</string>
    <string name="tips_line_hold_button">Hold the cable button about half a second — quick taps are ignored.</string>
    <string name="tips_line_press_toggle">Press the cable button once for a snapshot, twice quickly to start or stop recording.</string>
    <!-- %1$s is media_folder_name, so the promise and the album can never drift apart. -->
    <string name="tips_line_gallery_location">Photos and clips land in your Gallery, in a folder called %1$s.</string>
